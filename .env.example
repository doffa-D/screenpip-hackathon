AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Or AI_PROVIDER=openai (also supports compatible endpoints)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# For deployments requiring disabled reasoning with Chat Completions tools:
# REASONING_EFFORT=none

AGENT_TIMEZONE=Europe/Paris
MCP_COMMAND=npx
MCP_ARGS=["-y","screenpipe-mcp@latest"]
MCP_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=240
MAX_AGENT_ROUNDS=12
MAX_TOOL_RESULT_CHARS=24000
TASK_TTL_SECONDS=3600
MAX_STORED_TASKS=200
DATA_DIR=.data
MAX_EXECUTION_ROUNDS=60
# Glowing pointer + label on screen while a workflow runs (false to turn it off)
AGENT_OVERLAY=true
AGENT_OVERLAY_MASCOT=true
# Transparent PNG frame directory, relative to the project (or an absolute path).
AGENT_OVERLAY_MASCOT_PATH=assets/melonman_working
AGENT_OVERLAY_MASCOT_SIZE=64
AGENT_OVERLAY_MASCOT_FPS=4
EXECUTION_TIMEOUT_SECONDS=600
# Zavora stdio operations (Node.js 20+ required; run diagnostics to warm npx cache)
DESKTOP_TIMEOUT_SECONDS=20
# Optional, inherited by the MCP child process if your recorder needs them:
# SCREENPIPE_LOCAL_API_URL=http://localhost:3030
# SCREENPIPE_LOCAL_API_KEY=

# Autonomous workflow discovery (read-only history scans, while the app is open)
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_MINUTES=30
DISCOVERY_STARTUP_DELAY_SECONDS=30
DISCOVERY_LOOKBACK_DAYS=7
DISCOVERY_CHUNK_HOURS=24
DISCOVERY_OVERLAP_MINUTES=5
DISCOVERY_SETTLE_SECONDS=60
DISCOVERY_MEDIUM_CONFIDENCE=0.65
DISCOVERY_HIGH_CONFIDENCE=0.85

# Automatic memory indexing reuses the discovery worker (no second scanner).
SYNC_STARTUP_DELAY_SECONDS=2
SYNC_INITIAL_LOOKBACK_DAYS=1
# Periodic interval is DISCOVERY_INTERVAL_MINUTES above.

# Night shift: notice the missing next step, prepare it overnight inside a scope you approved (turn it on in the app)
NIGHTSHIFT_UNFINISHED_PASS=true
NIGHTSHIFT_HORIZON_HOURS=24
NIGHTSHIFT_MIN_SUPPORT=2
NIGHTSHIFT_MIN_PROBABILITY=0.6
# Show clearly marked fake examples on the Night shift page until real suggestions exist (false removes them)
NIGHTSHIFT_DEMO=true
